# Copy to /etc/default/agent-material, then fill in real values.

SERVER_PORT=8080
RUOYI_PROFILE=/opt/agentForMaterial/uploadPath

DB_URL="jdbc:mysql://127.0.0.1:3306/aiforscience?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai"
DB_USERNAME=aiforscience
DB_PASSWORD=replace_with_a_strong_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# 服务器上直接访问本机 MinerU 与 Qwen，不需要 SSH 端口转发。
MINERU_API_URL=http://127.0.0.1:8001
MINERU_CONNECT_TIMEOUT=30000
MINERU_RESPONSE_TIMEOUT=300000
QWEN_BASE_URL=http://127.0.0.1:8081/v1
QWEN_MODEL=qwen3.8-27b
QWEN_CONNECT_TIMEOUT=30000
QWEN_RESPONSE_TIMEOUT=300000
QWEN_TEMPERATURE=0
QWEN_MAX_TOKENS=262144

TOKEN_SECRET=replace_with_a_long_random_secret
DRUID_USERNAME=ruoyi
DRUID_PASSWORD=replace_with_a_strong_password

BAIDU_API_KEY=
BAIDU_API_SECRET=
ALIYUN_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_KEY_ID=
ALIYUN_OSS_KEY_SECRET=
ALIYUN_OSS_BUCKET=kkmaterial1

JAVA_OPTS="-Duser.timezone=Asia/Shanghai -Xms1g -Xmx2g -XX:+HeapDumpOnOutOfMemoryError"
